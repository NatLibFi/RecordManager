{
    "name": "natlibfi/recordmanager",
    "description": "Record management utility for VuFind",
    "authors": [
        {
            "name": "Ere Maijala",
            "email": "ere.maijala@helsinki.fi"
        }
    ],
    "license": "GPL-2.0",
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "RecordManager\\": "src/RecordManager/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RecordManagerTest\\": "tests/RecordManagerTest/"
        }
    },
    "provide": {
        "ext-mongodb": "*"
    },
    "require": {
        "php": ">=8.2.27",
        "cash/lrucache": "1.0.0",
        "guzzlehttp/guzzle": "7.15.2",
        "laminas/laminas-mvc": "3.8.0",
        "laminas/laminas-router": "3.18.0",
        "laminas/laminas-servicemanager": "3.23.0",
        "laminas/laminas-xml": "1.8.0",
        "league/mime-type-detection": "1.16.0",
        "ml/json-ld": "1.2.1",
        "mongodb/mongodb": "2.3.0",
        "pcrov/jsonreader": "1.0.4",
        "phayes/geophp": "1.2",
        "pietercolpaert/hardf": "0.6.2",
        "symfony/console": "6.4.25",
        "symfony/lock": "6.4.37",
        "vufind-org/vufind-marc": "1.2.0",
        "vufind-org/vufind-xml": "1.7.0",
        "wikimedia/composer-merge-plugin": "2.1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "3.95.4",
        "phing/phing": "3.1.2",
        "phpstan/phpstan": "2.2.2",
        "phpunit/phpunit": "11.5.55",
        "rector/rector": "2.4.5",
        "squizlabs/php_codesniffer": "4.0.2",
        "vimeo/psalm": "6.16.1"
    },
    "scripts": {
        "fix": "phing fix-php",
        "qa": "phing qa-tasks"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": true,
            "replace": true,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": true
        }
    }
}
